{
  "name": "alpine-ski-pro",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check_skier.mjs && vitest run --exclude tests/browser/**",
    "test:e2e": "playwright test",
    "assets": "node scripts/build_skier_pro.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json *.html docs/*.md README.md AGENTS.md",
    "assets:verify": "node scripts/check_skier.mjs",
    "prebuild": "npm run assets && npm run assets:verify"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "playcanvas": "2.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "^4.0.18"
  }
}
